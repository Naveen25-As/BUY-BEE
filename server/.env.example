PORT=5000
NODE_ENV=development

# Supabase (Project Settings -> API). Backend only: NEVER put the service role key in the client/Vite env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional rate limits (requests per 15 minutes per IP)
# RATE_LIMIT_MAX=200
# AUTH_RATE_LIMIT_MAX=50

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@buybee.com

# Only needed for the one-time data migration (npm run migrate:mongo). Read-only access is enough.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/buybee

PORT=5000
NODE_ENV=development
# MongoDB connection string - use MongoDB Atlas or local MongoDB
# See MONGODB_SETUP.md for detailed instructions
MONGODB_URI=mongodb://127.0.0.1:27017/buybee
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.mongodb.net/buybee?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@buybee.com
